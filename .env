
###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> tyrolium/api ###
API_VERSION=1.0.0
###< tyrolium/api ###

###> symfony/routing ###
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> nelmio/cors-bundle ###
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'
###< nelmio/cors-bundle ###

###> lexik/jwt-authentication-bundle ###
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
# JWT_PASSPHRASE volontairement absent d'ici : c'est un vrai secret de signature,
# pas juste un chemin de fichier. Valeur dev/test dans .env.dev/.env.test (comme
# APP_SECRET), valeur prod dans le Secrets Vault (.doc/secrets-vault.md), jamais ici.
###< lexik/jwt-authentication-bundle ###
